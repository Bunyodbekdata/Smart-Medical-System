# =====================================================================
# MedClinic / Xushvaqt Clinic Platform - Environment Variables Example
# =====================================================================
# Copy this file to .env.local and fill in real values from your
# Supabase Project Settings -> API. NEVER commit .env.local to git.

# Public Supabase connection (safe for browser client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only secret key (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Clinic identifier (matches public.clinics.id for single-clinic deployment;
# multi-clinic deployments can resolve clinic by subdomain or slug)
NEXT_PUBLIC_DEFAULT_CLINIC_SLUG=xushvaqt-medclinic

# Public base URL (used for generating tracking QR/links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Local Embedded PostgreSQL 16 (@electric-sql/pglite) mode when cloud Supabase is not set
# MEDCLINIC_LOCAL_PG=true
# LOCAL_AUTH_SECRET=replace-with-random-secret
# LOCAL_SUPER_ADMIN_USERNAME=superadmin
# LOCAL_SUPER_ADMIN_EMAIL=rahbar@medclinic.uz
# LOCAL_SUPER_ADMIN_PASSWORD=replace-with-strong-password
# LOCAL_ADMIN_USERNAME=admin
# LOCAL_ADMIN_EMAIL=admin@medclinic.uz
# LOCAL_ADMIN_PASSWORD=replace-with-strong-password
# LOCAL_DOCTOR_USERNAME=dr_ali
# LOCAL_DOCTOR_EMAIL=ali@medclinic.uz
# LOCAL_DOCTOR_PASSWORD=replace-with-strong-password
