# =====================================================================
# MedClinic / Smart Medical System — Environment Variables Example
# =====================================================================
# Copy this file to .env.local for local dev, or add to Vercel Settings.
# NEVER commit .env.local to git.

# ---------------------------------------------------------------------
# OPTION A (Recommended Free Production): Neon PostgreSQL (neon.tech)
# ---------------------------------------------------------------------
# Paste your Neon pooled or direct connection string:
# DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
#
# Random 32+ char secret for signing staff session cookies:
# AUTH_SECRET=replace-with-strong-random-32-char-secret
#
# Initial staff accounts auto-created on first bootstrap (when auth.users is empty):
# SUPER_ADMIN_USERNAME=superadmin
# SUPER_ADMIN_EMAIL=rahbar@medclinic.uz
# SUPER_ADMIN_PASSWORD=ReplaceWithStrongPassword2026!
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@medclinic.uz
# ADMIN_PASSWORD=ReplaceWithStrongPassword2026!
# DOCTOR_USERNAME=dr_ali
# DOCTOR_EMAIL=ali@medclinic.uz
# DOCTOR_PASSWORD=ReplaceWithStrongPassword2026!

# ---------------------------------------------------------------------
# OPTION B: Cloud Supabase (overrides DATABASE_URL when both are set)
# ---------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---------------------------------------------------------------------
# Shared Clinic Config
# ---------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_CLINIC_SLUG=xushvaqt-medclinic
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------
# OPTION C: Local Embedded PostgreSQL 16 (PGlite — dev/demo only)
# ---------------------------------------------------------------------
# MEDCLINIC_LOCAL_PG=true
# LOCAL_AUTH_SECRET=replace-with-random-secret
# LOCAL_SUPER_ADMIN_USERNAME=superadmin
# LOCAL_SUPER_ADMIN_EMAIL=rahbar@medclinic.uz
# LOCAL_SUPER_ADMIN_PASSWORD=replace-with-strong-password
# LOCAL_ADMIN_USERNAME=admin
# LOCAL_ADMIN_EMAIL=admin@medclinic.uz
# LOCAL_ADMIN_PASSWORD=replace-with-strong-password
# LOCAL_DOCTOR_USERNAME=dr_ali
# LOCAL_DOCTOR_EMAIL=ali@medclinic.uz
# LOCAL_DOCTOR_PASSWORD=replace-with-strong-password
